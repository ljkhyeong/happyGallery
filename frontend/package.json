{
  "name": "happygallery-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "api:generate": "rm -rf src/generated/api && orval --config orval.config.ts",
    "api:check": "npm run api:generate && git diff --exit-code -- src/generated/api && test -z \"$(git ls-files --others --exclude-standard -- src/generated/api)\"",
    "preview": "vite preview",
    "e2e": "playwright test --grep @smoke",
    "e2e:full": "playwright test",
    "e2e:payment": "playwright test --grep @payment",
    "e2e:identity": "playwright test --grep @identity",
    "e2e:admin": "playwright test --grep @admin",
    "e2e:headed": "playwright test --grep @smoke --headed",
    "e2e:full:headed": "playwright test --headed",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@sentry/react": "^10.43.0",
    "@tanstack/react-query": "^5.90.21",
    "bootstrap": "^5.3.8",
    "lucide-react": "^1.25.0",
    "react": "^19.0.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.3.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "orval": "8.22.0",
    "sass-embedded": "^1.97.3",
    "typescript": "~5.7.0",
    "vite": "^6.2.0"
  }
}
