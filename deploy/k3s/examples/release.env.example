# 비밀값이 아닌 배포 식별자만 둔다. 실제 파일은 저장소 밖에서 관리한다.
PUBLIC_HOST=gallery.example.com
ACME_EMAIL=ops@example.com
APP_IMAGE=localhost/happygallery-app:REPLACE_WITH_40_CHARACTER_GIT_SHA
FRONTEND_IMAGE=localhost/happygallery-frontend:REPLACE_WITH_40_CHARACTER_GIT_SHA
APP_IMAGE_DIGEST=sha256:REPLACE_WITH_64_CHARACTER_IMAGE_DIGEST
FRONTEND_IMAGE_DIGEST=sha256:REPLACE_WITH_64_CHARACTER_IMAGE_DIGEST
IMAGE_TAG=REPLACE_WITH_40_CHARACTER_GIT_SHA
GOOGLE_OAUTH_REDIRECT_URI=https://gallery.example.com/api/v1/auth/social/callback/google
NAVER_OAUTH_REDIRECT_URI=https://gallery.example.com/api/v1/auth/social/callback/naver

# 기존 DB가 있는 rollout은 최근 DB·미디어·release 복구 묶음의 commit marker를 요구한다.
VERIFIED_RECOVERY_BUNDLE=/mnt/happygallery-backup/happygallery-YYYYMMDDTHHMMSSZ.recovery.env
