# DB 값은 mysql.env의 MYSQL_USER/MYSQL_PASSWORD와 같아야 한다.
DB_USERNAME=happygallery
DB_PASSWORD=

# 각 32바이트, 64자리 hex. DB 백업과 분리된 복구 저장소에도 보관한다.
# 기존 Secret의 아래 세 키는 데이터 재암호화·인덱스 재생성 절차 없이는 변경할 수 없다.
ENCRYPT_KEY=
HMAC_KEY=
GUEST_TOKEN_HMAC_SECRET=

TOSS_SECRET_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
KAKAO_API_KEY=
KAKAO_SENDER_KEY=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_NUMBER=

# 비어 있어도 애플리케이션은 기동할 수 있다.
SENTRY_DSN=
