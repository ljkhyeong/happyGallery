# DB 값은 mysql.env의 MYSQL_USER/MYSQL_PASSWORD와 같아야 한다.
DB_USERNAME=happygallery
DB_PASSWORD=

# AES/HMAC은 각 32바이트, 64자리 hex. DB 백업과 분리된 복구 저장소에도 보관한다.
# 기존 값 변경에는 create-secrets.sh가 아니라 rotate-data-keys.sh를 사용한다.
FIELD_ENCRYPTION_KEY_ID=v1
ENCRYPT_KEY=
HMAC_KEY=
PREVIOUS_ENCRYPT_KEYS=
PREVIOUS_HMAC_KEYS=
GUEST_TOKEN_HMAC_SECRET=
GUEST_TOKEN_PREVIOUS_HMAC_SECRET=

# 이전 AES/HMAC 키 형식은 쉼표로 구분한 keyId=64자리hex 목록이다.
# 회전 완료 후 finalize 전까지 예: PREVIOUS_ENCRYPT_KEYS=v1=<old-key>

TOSS_SECRET_KEY=
PAYMENT_TIMEOUT_MILLIS=5000
TOSS_TIMEOUT_MILLIS=3000
TOSS_CONNECT_TIMEOUT_MILLIS=1000
TOSS_ACQUIRE_TIMEOUT_MILLIS=500
# 무료 우체국 API: 활용 승인 후 Decoding 서비스키를 넣고 활성화한다.
KOREA_POST_TRACKING_ENABLED=false
KOREA_POST_SERVICE_KEY=
KOREA_POST_TIMEOUT_MILLIS=5000
KOREA_POST_CONNECT_TIMEOUT_MILLIS=1000
KOREA_POST_ACQUIRE_TIMEOUT_MILLIS=500
# Delivery API는 국내 신규 무료 운영 플랜이 없어 비활성으로 유지한다.
DELIVERY_TRACKING_ENABLED=false
DELIVERY_API_KEY=
DELIVERY_API_SECRET_KEY=
DELIVERY_WEBHOOK_ENDPOINT_ID=
DELIVERY_WEBHOOK_SECRET=
DELIVERY_API_TIMEOUT_MILLIS=3000
DELIVERY_API_CONNECT_TIMEOUT_MILLIS=1000
DELIVERY_API_ACQUIRE_TIMEOUT_MILLIS=500
# 무료 자동 입력 방지: happy-gallery.com용 Managed 위젯 키를 발급한 뒤 활성화한다.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=happy-gallery.com
# 무료 검색엔진 변경 알림. indexnow.env와 같은 키를 넣는다. 빈 값이면 비활성.
INDEXNOW_KEY=
PUBLIC_HOLIDAY_ENABLED=false
PUBLIC_HOLIDAY_SERVICE_KEY=
PUBLIC_HOLIDAY_TIMEOUT_MILLIS=5000
PUBLIC_HOLIDAY_CONNECT_TIMEOUT_MILLIS=1000
PUBLIC_HOLIDAY_ACQUIRE_TIMEOUT_MILLIS=500
# 스마트스토어를 연결할 때만 활성화한다. 네이버 로그인 키와 별개다.
SMARTSTORE_ENABLED=false
SMARTSTORE_CLIENT_ID=
SMARTSTORE_CLIENT_SECRET=
SMARTSTORE_ACCOUNT_TYPE=SELF
SMARTSTORE_ACCOUNT_ID=
SMARTSTORE_TIMEOUT_MILLIS=5000
SMARTSTORE_CONNECT_TIMEOUT_MILLIS=1000
SMARTSTORE_ACQUIRE_TIMEOUT_MILLIS=500
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
# nhn(기본): 실제 발송. 심사 대기 중 사전 점검만 disabled로 실행한다.
# disabled에서는 휴대폰 인증 실패·고객 알림 실패로 처리하며 이메일은 계속 사용한다.
NOTIFICATION_MODE=nhn
ALIMTALK_APP_KEY=
ALIMTALK_SECRET_KEY=
ALIMTALK_SENDER_KEY=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_NUMBER=
# smtp 또는 ncp. ncp는 한국 리전 Cloud Outbound Mailer API를 사용한다.
EMAIL_VERIFICATION_PROVIDER=smtp
NCP_MAIL_ACCESS_KEY=
NCP_MAIL_SECRET_KEY=
NCP_MAIL_TIMEOUT_MILLIS=2000
NCP_MAIL_CONNECT_TIMEOUT_MILLIS=1000
NCP_MAIL_ACQUIRE_TIMEOUT_MILLIS=500
# smtp를 선택할 때만 아래 SMTP 자격 증명을 입력한다.
EMAIL_VERIFICATION_SMTP_HOST=
EMAIL_VERIFICATION_SMTP_PORT=587
EMAIL_VERIFICATION_SMTP_USERNAME=
EMAIL_VERIFICATION_SMTP_PASSWORD=
EMAIL_VERIFICATION_FROM=

# 기본값 0은 무료 배송이다. 유료 배송을 시작하기 전에 실제 금액으로 설정한다.
ORDER_SHIPPING_FEE=0

# 바깥 TimeLimiter(5초)는 각 transport 단계 합(0.5 + 1 + 2초)보다 크게 유지한다.
NOTIFICATION_TIMEOUT_MILLIS=5000
ALIMTALK_TIMEOUT_MILLIS=2000
ALIMTALK_CONNECT_TIMEOUT_MILLIS=1000
ALIMTALK_ACQUIRE_TIMEOUT_MILLIS=500
SMS_TIMEOUT_MILLIS=2000
SMS_CONNECT_TIMEOUT_MILLIS=1000
SMS_ACQUIRE_TIMEOUT_MILLIS=500
EMAIL_VERIFICATION_TIMEOUT_MILLIS=7000
EMAIL_VERIFICATION_CONNECTION_TIMEOUT_MILLIS=1000
EMAIL_VERIFICATION_READ_TIMEOUT_MILLIS=2000
EMAIL_VERIFICATION_WRITE_TIMEOUT_MILLIS=2000
EMAIL_VERIFICATION_STARTTLS_ENABLED=true
EMAIL_VERIFICATION_SSL_ENABLED=false
EMAIL_VERIFICATION_EXECUTOR_POOL_SIZE=2
EMAIL_VERIFICATION_EXECUTOR_QUEUE_CAPACITY=10

# 비어 있어도 애플리케이션은 기동할 수 있다.
SENTRY_DSN=
