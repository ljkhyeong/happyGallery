# systemd EnvironmentFile용. 값에 shell 따옴표를 넣지 않는다.
KUBECONFIG=/etc/rancher/k3s/k3s.yaml
KUBECTL_BIN=/usr/local/bin/kubectl
BACKUP_DIR=/mnt/off-device/happygallery
BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_RECIPIENT_PUBLIC_KEY
BACKUP_RETENTION_DAYS=30
# 기본값은 /root/.local/state/happygallery/releases다. rollout 실행 사용자와 다르면 명시한다.
HAPPYGALLERY_RELEASE_DIR=/root/.local/state/happygallery/releases
