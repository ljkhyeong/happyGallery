# systemd EnvironmentFile용. 실제 파일은 600 권한으로 저장한다.
BACKUP_ALERT_WEBHOOK_URL=https://replace-with-external-alert-receiver.example.com/hook
# Resend SMTP 사용 시 위 WEBHOOK_URL 행을 삭제하고 아래 두 행을 사용한다.
# BACKUP_ALERT_EMAIL_CONFIG=/etc/happygallery/alertmanager.env
# BACKUP_ALERT_APP_ENV=/etc/happygallery/app.env
# 무료 Telegram 사용 시 WEBHOOK_URL 행을 삭제하고 아래 행만 사용한다.
# BACKUP_ALERT_CONFIG=/etc/happygallery/alertmanager-telegram.env
