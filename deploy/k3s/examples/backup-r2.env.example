# systemd EnvironmentFile용. 비밀값은 rclone.conf에만 저장한다.
KUBECONFIG=/etc/rancher/k3s/k3s.yaml
KUBECTL_BIN=/usr/local/bin/kubectl
BACKUP_STORAGE=rclone
# 이 디렉터리는 전송용 로컬 캐시이며 외부 백업 완료의 증거가 아니다.
BACKUP_DIR=/var/lib/happygallery/backup-cache
BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_RECIPIENT_PUBLIC_KEY
BACKUP_RETENTION_DAYS=30
RCLONE_BIN=/usr/local/bin/rclone
RCLONE_CONFIG=/etc/happygallery/rclone.conf
RCLONE_BACKUP_REMOTE=hg-r2:happygallery-backups/happygallery
# rollout을 실행하는 실제 사용자의 release 경로와 일치시킨다.
HAPPYGALLERY_RELEASE_DIR=/home/ronaldo/.local/state/happygallery/releases

# 선택: 원격 내용 검증 후 배포 계정의 캐시에 로컬 전달하여 재다운로드를 생략한다.
# prepare-cd-backup.sh가 사용하는 캐시 경로와 같아야 한다.
# RCLONE_VERIFIED_CACHE_USER=ronaldo
# RCLONE_VERIFIED_CACHE_DIR=/home/ronaldo/.local/state/happygallery/cd/backups
