{
  "uid": "happygallery-system",
  "title": "happyGallery — System",
  "tags": ["happygallery", "system"],
  "timezone": "Asia/Seoul",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate (5m avg)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{application=\"happygallery\"}[5m])",
          "legendFormat": "{{method}} {{uri}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP Response Time p95 (5m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket{application=\"happygallery\"}[5m]))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP 5xx Ratio (5m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"happygallery\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{application=\"happygallery\"}[5m])), 0.001)",
          "legendFormat": "5xx ratio"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 4,
      "title": "JVM Heap Used",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application=\"happygallery\",area=\"heap\"}",
          "legendFormat": "{{id}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 5,
      "title": "JVM GC Pause (5m rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{application=\"happygallery\"}[5m])",
          "legendFormat": "{{action}} {{cause}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6,
      "title": "HikariCP Active Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"happygallery\"}",
          "legendFormat": "active"
        },
        {
          "expr": "hikaricp_connections_idle{application=\"happygallery\"}",
          "legendFormat": "idle"
        },
        {
          "expr": "hikaricp_connections_max{application=\"happygallery\"}",
          "legendFormat": "max"
        }
      ]
    },
    {
      "id": 7,
      "title": "Tomcat Threads",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "tomcat_threads_current_threads{application=\"happygallery\"}",
          "legendFormat": "current"
        },
        {
          "expr": "tomcat_threads_busy_threads{application=\"happygallery\"}",
          "legendFormat": "busy"
        },
        {
          "expr": "tomcat_threads_config_max_threads{application=\"happygallery\"}",
          "legendFormat": "max"
        }
      ]
    },
    {
      "id": 8,
      "title": "Notification Executor Threads",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "executor_active_threads{application=\"happygallery\",name=\"notificationExecutor\"}",
          "legendFormat": "active"
        },
        {
          "expr": "executor_pool_size_threads{application=\"happygallery\",name=\"notificationExecutor\"}",
          "legendFormat": "pool size"
        },
        {
          "expr": "executor_pool_max_threads{application=\"happygallery\",name=\"notificationExecutor\"}",
          "legendFormat": "max"
        }
      ]
    },
    {
      "id": 9,
      "title": "Payment Executor Threads & Queue",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "executor_active_threads{application=\"happygallery\",name=\"paymentTimeoutExecutor\"}",
          "legendFormat": "active"
        },
        {
          "expr": "executor_pool_size_threads{application=\"happygallery\",name=\"paymentTimeoutExecutor\"}",
          "legendFormat": "pool size"
        },
        {
          "expr": "executor_pool_max_threads{application=\"happygallery\",name=\"paymentTimeoutExecutor\"}",
          "legendFormat": "max"
        },
        {
          "expr": "executor_queued_tasks{application=\"happygallery\",name=\"paymentTimeoutExecutor\"}",
          "legendFormat": "queued"
        },
        {
          "expr": "executor_queue_remaining_tasks{application=\"happygallery\",name=\"paymentTimeoutExecutor\"}",
          "legendFormat": "queue remaining"
        },
        {
          "expr": "increase(happygallery_payment_executor_rejected_total{application=\"happygallery\"}[5m])",
          "legendFormat": "rejected (5m)"
        }
      ]
    },
    {
      "id": 10,
      "title": "JVM Threads",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        {
          "expr": "jvm_threads_live_threads{application=\"happygallery\"}",
          "legendFormat": "live"
        },
        {
          "expr": "jvm_threads_peak_threads{application=\"happygallery\"}",
          "legendFormat": "peak"
        }
      ]
    },
    {
      "id": 11,
      "title": "Process CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 40 },
      "targets": [
        {
          "expr": "process_cpu_usage{application=\"happygallery\"}",
          "legendFormat": "app"
        },
        {
          "expr": "system_cpu_usage{application=\"happygallery\"}",
          "legendFormat": "system"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 12,
      "title": "Notification Channel Executor Threads & Queue",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 48 },
      "targets": [
        {
          "expr": "executor_active_threads{application=\"happygallery\",name=~\"alimtalkNotificationTimeoutExecutor|smsNotificationTimeoutExecutor|phoneVerificationTimeoutExecutor|emailVerificationTimeoutExecutor\"}",
          "legendFormat": "{{name}} active"
        },
        {
          "expr": "executor_pool_size_threads{application=\"happygallery\",name=~\"alimtalkNotificationTimeoutExecutor|smsNotificationTimeoutExecutor|phoneVerificationTimeoutExecutor|emailVerificationTimeoutExecutor\"}",
          "legendFormat": "{{name}} pool size"
        },
        {
          "expr": "executor_queued_tasks{application=\"happygallery\",name=~\"alimtalkNotificationTimeoutExecutor|smsNotificationTimeoutExecutor|phoneVerificationTimeoutExecutor|emailVerificationTimeoutExecutor\"}",
          "legendFormat": "{{name}} queued"
        },
        {
          "expr": "executor_queue_remaining_tasks{application=\"happygallery\",name=~\"alimtalkNotificationTimeoutExecutor|smsNotificationTimeoutExecutor|phoneVerificationTimeoutExecutor|emailVerificationTimeoutExecutor\"}",
          "legendFormat": "{{name}} queue remaining"
        },
        {
          "expr": "increase({application=\"happygallery\",__name__=~\"happygallery_notification_(alimtalk|sms|phone_verification|email_verification)_executor_rejected_total\"}[5m])",
          "legendFormat": "{{__name__}} (5m)"
        }
      ]
    },
    {
      "id": 13,
      "title": "Refund Backlog by Status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 56 },
      "targets": [
        {
          "expr": "max by (status) (happygallery_refund_backlog_count{application=\"happygallery\"})",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 14,
      "title": "Refund Backlog Oldest Action Age",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 56 },
      "targets": [
        {
          "expr": "max by (status) (happygallery_refund_backlog_oldest_age_seconds{application=\"happygallery\"})",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 15,
      "title": "Notification Outbox Backlog by Status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 64 },
      "targets": [
        {
          "expr": "max by (status) (happygallery_notification_outbox_backlog_count{application=\"happygallery\"})",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 16,
      "title": "Notification Outbox Oldest Action Age",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 64 },
      "targets": [
        {
          "expr": "max by (status) (happygallery_notification_outbox_backlog_oldest_age_seconds{application=\"happygallery\"})",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 17,
      "title": "Operational Backlog Snapshot Freshness",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 72 },
      "targets": [
        {
          "expr": "max by (source) (happygallery_operational_backlog_refresh_age_seconds{application=\"happygallery\"})",
          "legendFormat": "{{source}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 18,
      "title": "External Circuit Breaker State",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 80 },
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_state{application=\"happygallery\",name=~\"paymentProvider|alimtalkNotification|smsNotification|phoneVerificationSms|emailVerification\"} == 1",
          "legendFormat": "{{name}} {{state}}"
        }
      ]
    },
    {
      "id": 19,
      "title": "External Circuit Breaker Failure Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 80 },
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_failure_rate{application=\"happygallery\",name=~\"paymentProvider|alimtalkNotification|smsNotification|phoneVerificationSms|emailVerification\"}",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "id": 20,
      "title": "External Circuit Breaker Calls (5m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 88 },
      "targets": [
        {
          "expr": "sum by (name, kind) (increase(resilience4j_circuitbreaker_calls_seconds_count{application=\"happygallery\",name=~\"paymentProvider|alimtalkNotification|smsNotification|phoneVerificationSms|emailVerification\"}[5m]))",
          "legendFormat": "{{name}} {{kind}}"
        },
        {
          "expr": "sum by (name) (increase(resilience4j_circuitbreaker_not_permitted_calls_total{application=\"happygallery\",name=~\"paymentProvider|alimtalkNotification|smsNotification|phoneVerificationSms|emailVerification\"}[5m]))",
          "legendFormat": "{{name}} not_permitted"
        }
      ]
    },
    {
      "id": 21,
      "title": "Payment Reconciliation Backlog",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 96 },
      "targets": [
        {
          "expr": "max(happygallery_payment_confirm_reconciliation_backlog_count{application=\"happygallery\"})",
          "legendFormat": "reconciliation required"
        }
      ]
    },
    {
      "id": 22,
      "title": "Payment Reconciliation Oldest Action Age",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 96 },
      "targets": [
        {
          "expr": "max(happygallery_payment_confirm_reconciliation_backlog_oldest_age_seconds{application=\"happygallery\"})",
          "legendFormat": "oldest action"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 23,
      "title": "Order Approval Backlog",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 104 },
      "targets": [
        {
          "expr": "max(happygallery_order_approval_backlog_count{application=\"happygallery\"})",
          "legendFormat": "pending approval"
        }
      ]
    },
    {
      "id": 24,
      "title": "Order Approval Oldest Age",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 104 },
      "targets": [
        {
          "expr": "max(happygallery_order_approval_backlog_oldest_age_seconds{application=\"happygallery\"})",
          "legendFormat": "oldest paid order"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 25,
      "title": "Booking Cancellation Task Backlog",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 112 },
      "targets": [
        {
          "expr": "max(happygallery_booking_cancellation_task_backlog_count{application=\"happygallery\"})",
          "legendFormat": "pending task"
        }
      ]
    },
    {
      "id": 26,
      "title": "Booking Cancellation Task Oldest Age",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 112 },
      "targets": [
        {
          "expr": "max(happygallery_booking_cancellation_task_backlog_oldest_age_seconds{application=\"happygallery\"})",
          "legendFormat": "oldest task"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ],
  "schemaVersion": 39
}
