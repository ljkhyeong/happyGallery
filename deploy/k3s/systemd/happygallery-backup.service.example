[Unit]
Description=happyGallery encrypted database and media backup
After=k3s.service network-online.target
Requires=k3s.service
OnFailure=happygallery-backup-failure@%n.service

[Service]
Type=oneshot
User=root
StateDirectory=happygallery
RuntimeDirectory=happygallery
RuntimeDirectoryMode=0700
TimeoutStartSec=30m
TimeoutStopSec=10m
EnvironmentFile=/etc/happygallery/backup.env
WorkingDirectory=/opt/happygallery
ExecStartPre=/opt/happygallery/deploy/k3s/scripts/manage-backup-alert-silence.sh start /run/happygallery/backup-alert-silence-id
ExecStart=/opt/happygallery/deploy/k3s/scripts/backup-mysql.sh
ExecStartPost=/opt/happygallery/deploy/k3s/scripts/prune-backups.sh
ExecStartPost=/usr/bin/touch /var/lib/happygallery/backup.last-success
ExecStopPost=/opt/happygallery/deploy/k3s/scripts/manage-backup-alert-silence.sh stop /run/happygallery/backup-alert-silence-id
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
