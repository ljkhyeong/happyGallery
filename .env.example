# ── MySQL ──────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_USER=happygallery
MYSQL_PASSWORD=

# Spring Boot DB (로컬 기본값 오버라이드 시)
# DB_URL=jdbc:mysql://localhost:3306/happygallery?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
# DB_USERNAME=happygallery
# DB_PASSWORD=

# ── Redis ─────────────────────────────────────
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_CONNECT_TIMEOUT=1s
# REDIS_COMMAND_TIMEOUT=1s

# 회원 세션 쿠키. 운영 기본값은 true이며 local 프로필은 false로 고정한다.
# SESSION_SECURE_COOKIE=true

# 처리율 제한. 전달 헤더 신뢰는 통제된 ingress 뒤에서 FORWARD_HEADERS_STRATEGY로만 설정한다.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_KEY_PREFIX=happygallery:rate
# FORWARD_HEADERS_STRATEGY=none

# ── 개인정보 암호화 (각 32바이트, 64자리 hex) ──
FIELD_ENCRYPTION_KEY_ID=v1
ENCRYPT_KEY=
HMAC_KEY=
PREVIOUS_ENCRYPT_KEYS=
PREVIOUS_HMAC_KEYS=
GUEST_TOKEN_HMAC_SECRET=
GUEST_TOKEN_PREVIOUS_HMAC_SECRET=
# GUEST_TOKEN_EXPIRY_HOURS=720
# GUEST_TOKEN_RECOVERY_EXPIRY_HOURS=24

# ── 관리자 ────────────────────────────────────
# ADMIN_API_KEY=          # local 프로필에서만 사용
ADMIN_SETUP_TOKEN=

# ── 알림: NHN Cloud Alimtalk v2.2 ─────────────
ALIMTALK_APP_KEY=
ALIMTALK_SECRET_KEY=
ALIMTALK_SENDER_KEY=
# ALIMTALK_BASE_URL=https://kakaotalk-bizmessage.api.nhncloudservice.com
# NOTIFICATION_TIMEOUT_MILLIS=5000
# ALIMTALK_TIMEOUT_MILLIS=2000
# ALIMTALK_CONNECT_TIMEOUT_MILLIS=1000
# ALIMTALK_ACQUIRE_TIMEOUT_MILLIS=500

# ── 알림: SMS (NHN Cloud) ─────────────────────
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_NUMBER=
# SMS_BASE_URL=https://sms.api.nhncloudservice.com
# SMS_TIMEOUT_MILLIS=2000
# SMS_CONNECT_TIMEOUT_MILLIS=1000
# SMS_ACQUIRE_TIMEOUT_MILLIS=500

# ── 소셜 로그인: Google / Naver ──────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/social/callback/google
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
# NAVER_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/social/callback/naver
# GOOGLE_OAUTH_TIMEOUT_MILLIS=5000
# NAVER_OAUTH_TIMEOUT_MILLIS=5000

# ── Sentry ────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=happygallery@1.0.0

# ── 결제: Toss Payments ───────────────────────
TOSS_SECRET_KEY=
# TOSS_BASE_URL=https://api.tosspayments.com
# TOSS_TIMEOUT_MILLIS=5000
# PASS_TOTAL_PRICE=240000
# ORDER_SHIPPING_FEE=0

# ── Sentry (Frontend) ────────────────────────
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_RELEASE=happygallery@1.0.0
VITE_TOSS_CLIENT_KEY=

# ── Grafana ───────────────────────────────────
# GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
